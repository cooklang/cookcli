\begin{center}
Servings: 4
\end{center}
% END_METADATA

\section*{Ingredients}

\begin{multicols}{2}
\begin{itemize}[leftmargin=*]
\item \textbf{200 g} \ingredient{plain flour}
\item \textbf{250 ml} \ingredient{whole milk}
\item \ingredient{fine sea salt}
\item \ingredient{sauce} \textit{(see recipe: ./sauce)}
\item \textbf{1 tbsp} \ingredient{icing sugar} --- sifted
\end{itemize}
\end{multicols}

\section*{Cookware}

\begin{itemize}[leftmargin=*]
\item \cookware{large mixing bowl}
\item \textbf{2} \cookware{pan}
\end{itemize}

\section*{Instructions}

\subsection*{Section 1}

\begin{enumerate}
\item Mix \ingredient{plain flour} with \ingredient{whole milk} in a \cookware{large mixing bowl} and beat until smooth, then add \ingredient{fine sea salt}.
\item Simmer \timer{gently: 10 minutes} in a \cookware{pan}, then rest \timer{5 minutes}.

\textit{Note: Rest the dough somewhere warm, covered.}

\end{enumerate}

\subsection*{Finishing}

\begin{enumerate}
\item Serve with \ingredient{sauce} and dust with \ingredient{icing sugar}.
\end{enumerate}

