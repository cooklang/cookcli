nutrition-help-energy-source = Regulation (EU) 1169/2011, Annex XIV; NHS, Fat: the facts (2023)
nutrition-help-lipids-source = NHS, Fat: the facts (2023)
nutrition-help-saturated-fat-source = WHO, Healthy diet (2026); NHS, Fat: the facts (2023)
nutrition-help-unsaturated-fat-source = WHO, Healthy diet (2026)
nutrition-help-monounsaturated-fat-source = NHS, Fat: the facts (2023)
nutrition-help-polyunsaturated-fat-source = NHS, Fat: the facts (2023)
nutrition-help-omega-3-source = NHS, Fat: the facts (2023)
nutrition-help-omega-6-source = NHS, Fat: the facts (2023)
nutrition-help-trans-fat-source = WHO, Trans fat (2024); NHS, Fat: the facts (2023)
nutrition-help-cholesterol-source = NHS, Fat: the facts (2023)
nutrition-help-carbohydrates-source = WHO, Healthy diet (2026); Regulation (EU) 1169/2011, Annex I
nutrition-help-sugars-source = WHO, Healthy diet (2026); NHS, Sugar: the facts (2023)
nutrition-help-starch-source = NHS, Starchy foods and carbohydrates (2023)
nutrition-help-fibers-source = WHO, Healthy diet (2026); NHS, How to get more fibre into your diet (2026)
nutrition-help-proteins-source = WHO, Healthy diet (2026)
nutrition-help-salt-source = WHO, Sodium reduction (2026); NHS, Salt in your diet (2023); Regulation (EU) 1169/2011, Annex I
nutrition-help-sodium-source = WHO, Sodium reduction (2026)
nutrition-help-energy-what = Vad livsmedlet ger kroppen, i kilokalorier (kcal) eller kilojoule (kJ).
nutrition-help-energy-use = Den räknas med fasta faktorer: 9 kcal per gram fett, 4 för kolhydrater och protein, 7 för alkohol, 2 för fibrer.
nutrition-help-lipids-what = Fetterna och oljorna i ett livsmedel.
nutrition-help-lipids-use = Fett ger essentiella fettsyror, hjälper till att ta upp vitamin A, D och E och ger 9 kcal per gram, mot 4 för kolhydrater och protein.
nutrition-help-saturated-fat-what = Fetter som kommer mest från animaliska källor, samt från palm- och kokosolja.
nutrition-help-saturated-fat-use = För mycket höjer det ”dåliga” LDL-kolesterolet och risken för hjärtsjukdom och stroke. WHO: mindre än 10 % av energin.
nutrition-help-saturated-fat-where = Fett kött, korv och pajer, smör, ghee och ister, ost, grädde, choklad, kex och kakor, palm- och kokosolja.
nutrition-help-unsaturated-fat-what = Fetter i fisk, avokado och nötter, samt i solros-, soja-, raps- och olivolja.
nutrition-help-unsaturated-fat-use = Att föredra framför mättat fett (WHO).
nutrition-help-monounsaturated-fat-what = En sorts omättat fett.
nutrition-help-monounsaturated-fat-use = Hjälper till att skydda hjärtat genom att behålla det ”goda” HDL-kolesterolet och sänka det ”dåliga” LDL.
nutrition-help-monounsaturated-fat-where = Oliv- och rapsolja, avokado, mandlar, paranötter, jordnötter.
nutrition-help-polyunsaturated-fat-what = En sorts omättat fett. Det finns två huvudtyper: omega-3 och omega-6.
nutrition-help-polyunsaturated-fat-use = Kroppen kan inte tillverka vissa former, så en liten mängd måste komma från maten.
nutrition-help-omega-3-what = Ett fleromättat fett som är nödvändigt i kosten.
nutrition-help-omega-3-use = Minst 2 portioner fisk i veckan rekommenderas, varav en fet fisk.
nutrition-help-omega-3-where = Fet fisk (sill, öring, sardiner, lax, makrill), linfröolja och rapsolja, valnötter.
nutrition-help-omega-6-what = Ett fleromättat fett som är nödvändigt i kosten.
nutrition-help-omega-6-use = De flesta får i sig tillräckligt.
nutrition-help-omega-6-where = Raps-, majs- och solrosolja, valnötter, mandlar, cashewnötter.
nutrition-help-trans-fat-what = Omättade fettsyror av industriellt eller naturligt ursprung.
nutrition-help-trans-fat-use = Liksom mättat fett höjer de kolesterolet. WHO: mindre än 1 % av energin.
nutrition-help-trans-fat-where = Margarin, matfett och friterad mat; naturligt i kött och mejeriprodukter från idisslare.
nutrition-help-cholesterol-what = Ett fettliknande ämne som kroppen mest bildar i levern.
nutrition-help-cholesterol-use = Mättat fett och transfett höjer det ”dåliga” LDL-kolesterolet i blodet.
nutrition-help-carbohydrates-what = Sockerarter, stärkelse och, beroende på standarden, fibrer.
nutrition-help-carbohydrates-use = Kroppens viktigaste energikälla (WHO): 4 kcal per gram.
nutrition-help-sugars-what = Fria sockerarter är alla som tillsätts i mat och dryck, plus de i honung, sirap och juice; sockret i mjölk, frukt och grönsaker räknas inte.
nutrition-help-sugars-use = För mycket ger viktuppgång och karies. WHO: fria sockerarter under 10 % av energin, ungefär 50 g.
nutrition-help-sugars-where = Godis, kakor, kex, choklad, läsk, flingor.
nutrition-help-starch-what = Kolhydraten i stärkelserika livsmedel, vår viktigaste källa till kolhydrater.
nutrition-help-starch-use = Stärkelserika livsmedel bör utgöra drygt en tredjedel av det man äter.
nutrition-help-starch-where = Potatis, bröd, ris, pasta, spannmål.
nutrition-help-fibers-what = Ämnen i cellväggarna hos grönsaker, frukt, baljväxter och spannmål.
nutrition-help-fibers-use = De hjälper matsmältningen och förebygger förstoppning. WHO: minst 25 g om dagen (30 g i Storbritannien).
nutrition-help-fibers-where = Fullkornsbröd och -pasta, brunt ris, potatis med skal, baljväxter, grönsaker, frukt, nötter och frön.
nutrition-help-proteins-what = Kroppens byggstenar, till exempel musklerna.
nutrition-help-proteins-use = 10 till 15 % av energin räcker vanligtvis för vuxna (WHO).
nutrition-help-salt-what = Bordssalt, natriumklorid. Salt = natrium × 2,5: 1 g salt innehåller 400 mg natrium.
nutrition-help-salt-use = För mycket höjer blodtrycket och risken för hjärtinfarkt och stroke. WHO: mindre än 5 g per dag.
nutrition-help-salt-where = Bröd, flingor, charkprodukter, färdigmat, såser, ost.
nutrition-help-sodium-what = Mineralet i bordssalt: 1 g salt innehåller 400 mg natrium.
nutrition-help-sodium-use = WHO: mindre än 2000 mg natrium per dag.
