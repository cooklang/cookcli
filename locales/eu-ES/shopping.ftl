# Shopping List
shopping-title = Erosketa zerrenda
shopping-empty = Zure erosketa zerrenda hutsik dago
shopping-no-items = Ez dago elementurik erosketa zerrendan. Hasteko, gehitu errezetak.
shopping-no-recipes = Ez dago errezetarik aukeratuta. Gehitu errezetak errezeten orritik.
shopping-item-count =
    { $count ->
        [one] { $count } elementu
       *[other] { $count } elementu
    }
shopping-from-recipe = { $recipeName }-tik
shopping-clear-confirm = Ziur zaude elementu guztiak ezabatu nahi dituzula?
shopping-added = { $itemName } erosketa zerrendara gehituta
shopping-removed = { $itemName } erosketa zerrendatik ezabatuta
shopping-cleared = Erosketa zerrenda hustuta
shopping-export = Esportatu
shopping-import = Inportatu
shopping-mark-done = Egindako moduan markatu
shopping-mark-undone = Egiteke moduan markatu
shopping-selected-recipes = Aukeratutako errezetak
shopping-clear-all = Ezabatu dena
shopping-in-pantry = Zure jaki-tokian
shopping-pantry-unused = Ezin izan da jakitegiko fitxategia irakurri, beraz zure jaki-tokiko ezer ez da zerrenda honetatik kendu.
shopping-pantry-open = Ireki jaki-tokia konpontzeko
shopping-remove = Ezabatu
shopping-add-recipes-first = Mesedez, lehenengo gehitu errezeta batzuk
shopping-failed-to-generate = Errorea erosketa zerrenda sortzerakoan
shopping-warnings = Errezeta batzuk berrikusi behar dira; baliteke zerrendan zerbait falta izatea:
shopping-warning-not-a-number = { $recipe }: ezin izan da { $reference } errezeta { $amount } kopurura egokitu, ez baita zenbaki bat. Idatzita dagoen bezala ageri da zerrendan, ez bere osagai gisa.
shopping-warning-no-servings = { $recipe }: ezin izan da { $reference } errezeta { $amount } kopurura egokitu: ez du anoa kopuru oso bat adierazten, adibidez `servings: 4`. Idatzita dagoen bezala ageri da zerrendan, ez bere osagai gisa.
shopping-warning-no-yield = { $recipe }: ezin izan da { $reference } errezeta { $amount } kopurura egokitu: ez du esaten zenbat ematen duen. Gehitu errendimendu bat zenbakia%unitatea formatuan, adibidez `yield: 500%{ $unit }`. Idatzita dagoen bezala ageri da zerrendan, ez bere osagai gisa.
shopping-warning-yield-unit = { $recipe }: ezin izan da { $reference } errezeta { $amount } kopurura egokitu: bere errendimendua { $unit } unitatean dago, beraz eskatu { $unit } unitatean. Idatzita dagoen bezala ageri da zerrendan, ez bere osagai gisa.
shopping-failed-to-add = Errorea erosketa zerrendara gehitzerakoan
shopping-error = Errorea
shopping-print = Inprimatu
shopping-include-in-list = Erosketa zerrendan sartu
shopping-optional = (aukerakoa)
shopping-copy = Kopiatu
shopping-copied = Kopiatuta!
shopping-copy-failed = Errorea kopiatzerakoan
shopping-copy-options = Kopiatzeko aukerak
shopping-copy-include-aisles = Sailen izenak sartu
shopping-copy-include-amounts = Kopuruak sartu
